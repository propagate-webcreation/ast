# Universal Form API - Token 認証（Server Action 方式 / v3.0.0）
# 管理画面: https://universal-form-api.vercel.app/auth/
#
# 🚨 NEXT_PUBLIC_ は絶対に付けない（トークンがブラウザに露出するため）
# 旧 NEXT_PUBLIC_FORM_API_TOKEN は廃止。残っていれば削除してください。

FORM_API_URL=https://universal-form-api.vercel.app/api/submit
FORM_API_SITE_ID=your_site_id
FORM_API_TOKEN=ufa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# エルメ友だち追加 → Meta コンバージョンAPI（app/api/lme-callback）
# エルメのパラメーターエクスポートには https://ast-lp.vercel.app/api/lme-callback?key=<LME_CALLBACK_KEY> を登録する
LME_CALLBACK_KEY=任意の長いランダム文字列
META_PIXEL_ID=1022586286719043
META_CAPI_TOKEN=イベントマネージャで発行したアクセストークン
# テスト中だけ設定（イベントマネージャ > テストイベント のコード）
META_TEST_EVENT_CODE=
